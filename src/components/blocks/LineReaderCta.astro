---
import { url } from '@/utils/url';

const addUrl = 'https://line.me/R/ti/p/@832sacsk';
---

<aside class="line-reader-cta" aria-labelledby="line-reader-cta-title">
  <div>
    <p class="line-reader-kicker">LINE 閱讀入口</p>
    <h2 id="line-reader-cta-title">每天一份新聞，看完就結束</h2>
    <p class="line-reader-copy">
      我們不主動推播。想看的時候打「新聞」，也能按分類或直接搜尋關鍵字。
    </p>
  </div>
  <div class="line-reader-actions">
    <a class="line-reader-add" href={addUrl} target="_blank" rel="noopener">加入 APPI News LINE</a>
    <a class="line-reader-more" href={url('/line/')}>了解怎麼使用</a>
  </div>
</aside>

<style>
  .line-reader-cta {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 24px;
    margin-block: 32px;
    padding: 24px;
    border: 1px solid var(--line);
    border-left: 4px solid var(--appi-brand);
    border-radius: var(--radius);
    background: var(--bg-soft);
  }
  .line-reader-kicker {
    margin: 0 0 4px;
    color: var(--appi-brand);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.06em;
  }
  .line-reader-cta h2 {
    margin: 0 0 6px;
    font-size: var(--text-lg);
  }
  .line-reader-copy {
    margin: 0;
    color: var(--ink-2);
    font-size: var(--text-sm);
    line-height: 1.7;
  }
  .line-reader-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    min-width: 180px;
  }
  .line-reader-add {
    display: inline-flex;
    justify-content: center;
    width: 100%;
    padding: 10px 16px;
    border-radius: 999px;
    background: var(--appi-brand);
    color: var(--white);
    font-size: var(--text-sm);
    font-weight: 700;
    text-decoration: none;
  }
  .line-reader-add:hover {
    background: var(--appi-brand-dark);
    text-decoration: none;
  }
  .line-reader-more {
    font-size: var(--text-xs);
    font-weight: 600;
  }
  @media (max-width: 640px) {
    .line-reader-cta {
      grid-template-columns: 1fr;
      gap: 18px;
    }
    .line-reader-actions {
      align-items: stretch;
    }
    .line-reader-more {
      text-align: center;
    }
  }
</style>
