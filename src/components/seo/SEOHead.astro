---
import { SITE } from '@/config/site';
import { absoluteUrl, asset } from '@/utils/url';
import { ogImageSize } from '@/utils/og-image-size';
import mirrorAlternates from '../../data/mirror-alternates.json';

interface Props {
  title: string;
  description?: string;
  /** 站內路徑（不含 base），用於 canonical */
  path: string;
  /** OG 圖：相對 BASE 的路徑或絕對網址 */
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  authorName?: string;
  authorPath?: string;
  keywords?: string[];
  /** 額外的 RSS feed（如分類 feed），會與全站 feed 一起在 <head> 宣告供自動探索 */
  rssHref?: string;
  rssTitle?: string;
}

const {
  title,
  description = SITE.description,
  path,
  ogImage,
  ogType = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  authorName,
  authorPath,
  keywords,
  rssHref,
  rssTitle,
} = Astro.props;

const fullTitle =
  path === '/' ? `${SITE.name}｜${SITE.tagline}` : `${title}｜${SITE.name}`;

const canonical = absoluteUrl(path, Astro.site);

// OG 圖：絕對網址直接用，否則視為相對 BASE 的資產 → 補成絕對
const ogImagePath = ogImage ?? SITE.defaultOgImage;
const ogImageAbs = /^https?:\/\//.test(ogImagePath)
  ? ogImagePath
  : new URL(asset(ogImagePath), Astro.site).toString();
// og:image 尺寸讀實際檔案，不寫死。讀不到（外部網址／檔案不存在）就不輸出這兩個 tag，
// 宣告錯的尺寸比不宣告更糟——爬蟲會據此預留版位而裁錯圖。
const ogSize = await ogImageSize(ogImagePath);

// 與 JSON-LD keywords 一致：過濾空字串
const keywordList = (keywords ?? []).filter(Boolean);

/**
 * hreflang 回指：文章若有多語鏡像版（jp／en／in.appi.news），列出它們＋自我參照。
 *
 * 為什麼：hreflang 是成對宣告。鏡像站已掛 `hreflang="zh-Hant"` 指回本站，
 * 本站不回指的話整組宣告對 Google 無效（沒有回指＝無效宣告），
 * 站長 2026-08-15 裁示補上。緣由與資料流見 docs/lessons/hreflang-mirror-return-links.md。
 *
 * 資料來源 `src/data/mirror-alternates.json` 由 appi.news-mirror 產線在部署後
 * 自動同步（scripts/sync-hreflang-to-publisher.mjs，有差異才 commit）——
 * **不要手改**，改了下一輪同步就被蓋掉。kid.appi.news 刻意不在表裡：
 * 它與本站同為 zh-Hant，hreflang 沒有「閱讀難度」維度，硬掛是錯誤訊號。
 *
 * 只有「查得到鏡像版」的文章頁才輸出；自我參照（zh-Hant → canonical）是
 * Google 的要求（每個版本都要列出含自己的完整清單）。noindex 頁不輸出。
 */
const articleMatch = /^\/articles\/([^/]+)\/?$/.exec(path.split(/[?#]/)[0]);
const mirrorEntries: { hreflang: string; href: string }[] =
  !noindex && articleMatch
    ? ((mirrorAlternates as Record<string, { hreflang: string; href: string }[]>)[
        decodeURIComponent(articleMatch[1])
      ] ?? [])
    : [];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />

<!-- 站台圖示 / PWA（非 render-blocking；hrefs 走 asset() 以對齊 base） -->
<link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
<link rel="icon" href={asset('favicon.ico')} sizes="32x32" />
<link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />
<link rel="manifest" href={asset('site.webmanifest')} />
<meta name="theme-color" content="#1f3a5f" />
{authorName && <meta name="author" content={authorName} />}
{keywordList.length > 0 && <meta name="keywords" content={keywordList.join(', ')} />}
<link rel="canonical" href={canonical} />
<link rel="license" href={SITE.license.url} />
<!-- hreflang 回指（多語鏡像站；見 frontmatter 註解與 docs/lessons/hreflang-mirror-return-links.md） -->
{mirrorEntries.length > 0 && <link rel="alternate" hreflang="zh-Hant" href={canonical} />}
{mirrorEntries.map((m) => (
  <link rel="alternate" hreflang={m.hreflang} href={m.href} />
))}
{
  noindex ? (
    <meta name="robots" content="noindex, nofollow" />
  ) : (
    <meta name="robots" content="max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  )
}

<!-- Open Graph -->
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageAbs} />
{ogSize && <meta property="og:image:width" content={String(ogSize.width)} />}
{ogSize && <meta property="og:image:height" content={String(ogSize.height)} />}
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{authorPath && <meta property="article:author" content={absoluteUrl(authorPath, Astro.site)} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageAbs} />
{SITE.x && <meta name="twitter:site" content={SITE.x} />}
{SITE.x && <meta name="twitter:creator" content={SITE.x} />}

<!-- RSS -->
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${SITE.name} RSS`}
  href={absoluteUrl('/rss.xml', Astro.site)}
/>
{rssHref && (
  <link
    rel="alternate"
    type="application/rss+xml"
    title={rssTitle ?? `${SITE.name} RSS`}
    href={absoluteUrl(rssHref, Astro.site)}
  />
)}
