---
import { SITE } from '@/config/site';
import { absoluteUrl, asset } from '@/utils/url';
import { ogImageSize } from '@/utils/og-image-size';

interface Props {
  title: string;
  description?: string;
  /** 站內路徑（不含 base），用於 canonical */
  path: string;
  /** OG 圖：相對 BASE 的路徑或絕對網址 */
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  authorName?: string;
  authorPath?: string;
  keywords?: string[];
  /** 額外的 RSS feed（如分類 feed），會與全站 feed 一起在 <head> 宣告供自動探索 */
  rssHref?: string;
  rssTitle?: string;
}

const {
  title,
  description = SITE.description,
  path,
  ogImage,
  ogType = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  authorName,
  authorPath,
  keywords,
  rssHref,
  rssTitle,
} = Astro.props;

const fullTitle =
  path === '/' ? `${SITE.name}｜${SITE.tagline}` : `${title}｜${SITE.name}`;

const canonical = absoluteUrl(path, Astro.site);

// OG 圖：絕對網址直接用，否則視為相對 BASE 的資產 → 補成絕對
const ogImagePath = ogImage ?? SITE.defaultOgImage;
const ogImageAbs = /^https?:\/\//.test(ogImagePath)
  ? ogImagePath
  : new URL(asset(ogImagePath), Astro.site).toString();
// og:image 尺寸讀實際檔案，不寫死。讀不到（外部網址／檔案不存在）就不輸出這兩個 tag，
// 宣告錯的尺寸比不宣告更糟——爬蟲會據此預留版位而裁錯圖。
const ogSize = await ogImageSize(ogImagePath);

// 與 JSON-LD keywords 一致：過濾空字串
const keywordList = (keywords ?? []).filter(Boolean);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />

<!-- 站台圖示 / PWA（非 render-blocking；hrefs 走 asset() 以對齊 base） -->
<link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
<link rel="icon" href={asset('favicon.ico')} sizes="32x32" />
<link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />
<link rel="manifest" href={asset('site.webmanifest')} />
<meta name="theme-color" content="#1f3a5f" />
{authorName && <meta name="author" content={authorName} />}
{keywordList.length > 0 && <meta name="keywords" content={keywordList.join(', ')} />}
<link rel="canonical" href={canonical} />
<link rel="license" href={SITE.license.url} />
{
  noindex ? (
    <meta name="robots" content="noindex, nofollow" />
  ) : (
    <meta name="robots" content="max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
  )
}

<!-- Open Graph -->
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageAbs} />
{ogSize && <meta property="og:image:width" content={String(ogSize.width)} />}
{ogSize && <meta property="og:image:height" content={String(ogSize.height)} />}
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{authorPath && <meta property="article:author" content={absoluteUrl(authorPath, Astro.site)} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageAbs} />
{SITE.x && <meta name="twitter:site" content={SITE.x} />}
{SITE.x && <meta name="twitter:creator" content={SITE.x} />}

<!-- RSS -->
<link
  rel="alternate"
  type="application/rss+xml"
  title={`${SITE.name} RSS`}
  href={absoluteUrl('/rss.xml', Astro.site)}
/>
{rssHref && (
  <link
    rel="alternate"
    type="application/rss+xml"
    title={rssTitle ?? `${SITE.name} RSS`}
    href={absoluteUrl(rssHref, Astro.site)}
  />
)}
