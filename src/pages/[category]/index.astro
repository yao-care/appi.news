---
import BaseLayout from '@/layouts/BaseLayout.astro';
import CategoryChannel from '@/components/blocks/CategoryChannel.astro';
import TopicCard from '@/components/blocks/TopicCard.astro';
import { CATEGORIES } from '@/config/categories';
import {
  getPublishedArticles,
  getAuthorMap,
  getTopics,
  byCategory,
  byTopic,
  articleSlug,
} from '@/utils/content';
import { url } from '@/utils/url';
import { breadcrumbLd, itemListLd } from '@/utils/jsonld';

const PAGE_SIZE = 18;

export async function getStaticPaths() {
  // 'columns' 由 /columns/ 專屬頁處理，這裡排除避免路由衝突
  return CATEGORIES.filter((c) => c.slug !== 'columns').map((c) => ({
    params: { category: c.slug },
    props: { category: c },
  }));
}

const { category } = Astro.props;
const all = await getPublishedArticles();
const authorMap = await getAuthorMap();
const authorNames = new Map(
  [...authorMap.entries()].map(([id, a]) => [id, a.data.name]),
);

const inCat = byCategory(all, category.slug);
const totalPages = Math.max(1, Math.ceil(inCat.length / PAGE_SIZE));
const pageArticles = inCat.slice(0, PAGE_SIZE);

// 分類頁補「相關專題」內鏈入口：只列同分類、已上線的專題，沒有就不顯示（不留空區塊）
// 手動指定的 articles 與 article.topics 反向關聯常重疊，需去重後才是實際顯示篇數
const relatedTopics = (await getTopics())
  .filter((t) => t.data.category === category.slug)
  .map((t) => {
    const manual = all.filter(
      (a) => t.data.articles.includes(articleSlug(a)) || t.data.articles.includes(a.id),
    );
    const seen = new Set<string>();
    const count = [...manual, ...byTopic(all, t.id)].filter((a) => {
      const key = articleSlug(a);
      if (seen.has(key)) return false;
      seen.add(key);
      return true;
    }).length;
    return { topic: t, count };
  });

const ld = [
  breadcrumbLd(Astro.site, [
    { name: '首頁', path: '/' },
    { name: category.name, path: `/${category.slug}/` },
  ]),
  itemListLd(
    Astro.site,
    pageArticles.map((a) => ({ name: a.data.title, path: `/articles/${articleSlug(a)}/` })),
    { name: `${category.name}最新文章` },
  ),
  ...(relatedTopics.length > 0
    ? [
        itemListLd(
          Astro.site,
          relatedTopics.map((r) => ({ name: r.topic.data.title, path: `/topics/${r.topic.id}/` })),
          { name: `${category.name}相關專題` },
        ),
      ]
    : []),
];
---
<BaseLayout
  title={`${category.name}｜${category.nameEn}`}
  description={category.description}
  path={`/${category.slug}/`}
  ogImage={`og/${category.slug}.png`}
  rssHref={`/${category.slug}/rss.xml`}
  rssTitle={`${category.name} RSS`}
  jsonld={ld}
>
  {category.slug === 'sports' && (
    <section class="sports-submit-cta">
      <div class="container">
        <span>🏅 學校、隊伍或主辦單位嗎？</span>
        <a href={url('/sports/submit/')}>提供你們的學生賽事資訊 →</a>
      </div>
    </section>
  )}
  <CategoryChannel
    category={category}
    pageArticles={pageArticles}
    allInCategory={inCat}
    authorNames={authorNames}
    currentPage={1}
    totalPages={totalPages}
    showHero={true}
  />
  {
    relatedTopics.length > 0 && (
      <div class="container">
        <section class="section related-topics">
          <div class="section-head"><h2>相關專題</h2></div>
          <div class="card-grid card-grid--3">
            {relatedTopics.map((r) => <TopicCard topic={r.topic} articleCount={r.count} />)}
          </div>
        </section>
      </div>
    )
  }
</BaseLayout>

<style>
  .related-topics { margin-top: 8px; }
  .sports-submit-cta { background: var(--color-surface-alt); border-radius: 10px; margin: 1rem auto 0; }
  .sports-submit-cta .container { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; align-items: center; padding: 0.8rem 1rem; }
  .sports-submit-cta span { font-weight: 600; }
  .sports-submit-cta a { font-weight: 700; color: var(--color-accent); text-decoration: none; }
  .sports-submit-cta a:hover { text-decoration: underline; }
</style>
