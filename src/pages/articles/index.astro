---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/blocks/ArticleCard.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import Pagination from '@/components/ui/Pagination.astro';
import {
  getPublishedArticles,
  getAuthorNames,
  articleListItems,
  PAGE_SIZE,
} from '@/utils/content';
import { breadcrumbLd, itemListLd } from '@/utils/jsonld';

const all = await getPublishedArticles();
const authorNames = await getAuthorNames();

const totalPages = Math.max(1, Math.ceil(all.length / PAGE_SIZE));
const pageArticles = all.slice(0, PAGE_SIZE);

const ld = [
  breadcrumbLd(Astro.site, [
    { name: '首頁', path: '/' },
    { name: '所有文章', path: '/articles/' },
  ]),
  itemListLd(Astro.site, articleListItems(pageArticles), {
    name: 'APPI News 所有文章',
  }),
];
---
<BaseLayout
  title="所有文章"
  description="APPI News 所有已發佈文章，依時間排序。"
  path="/articles/"
  jsonld={ld}
>
  <div class="container" style="padding-top:28px;">
    <Breadcrumbs items={[{ name: '所有文章' }]} />
    <div class="section-head" style="margin-top:18px;">
      <h2>所有文章（{all.length}）</h2>
    </div>
    <div class="card-grid card-grid--4">
      {pageArticles.map((a) => <ArticleCard article={a} variant="medium" authorName={authorNames.get(a.data.author)} />)}
    </div>
    <Pagination currentPage={1} totalPages={totalPages} base="/articles/" />
  </div>
</BaseLayout>
