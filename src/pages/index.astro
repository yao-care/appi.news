---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/blocks/ArticleCard.astro';
import HeroNetwork from '@/components/blocks/HeroNetwork.astro';
import ImageWithFallback from '@/components/ui/ImageWithFallback.astro';
import CategoryTag from '@/components/ui/CategoryTag.astro';
import { SITE } from '@/config/site';
import { CATEGORIES } from '@/config/categories';
import {
  getPublishedArticles,
  getAuthorNames,
  getTopics,
  featuredArticles,
  makeDeduper,
  articleSlug,
  articlePath,
  articleListItems,
  articlesForTopic,
  byCategory,
  bySubcategory,
  coverImageFor,
  coverAltFor,
} from '@/utils/content';
import { url } from '@/utils/url';
import { formatDate } from '@/utils/date';
import { itemListLd } from '@/utils/jsonld';
import { resolveSeasonalSlots } from '@/utils/seasonalTopics';

const all = await getPublishedArticles();
const authorNames = await getAuthorNames();
const authorName = (id: string) => authorNames.get(id) ?? 'APPI 編輯部';

const dedupe = makeDeduper();

// Hero：hero=true 優先，否則最新 featured，否則最新
const hero =
  all.find((a) => a.data.hero) ??
  all.find((a) => a.data.featured) ??
  all[0];
if (hero) dedupe.take([hero], 1);

// 精選右側：含小縮圖的清單，補滿左側大圖造成的縱向留白。
// 全站版心上限 1440px 後右欄不再夠寬切雙欄（會把標題擠成多行），固定單欄 5 則最平衡，
// 也避免多載 5 張看不到的縮圖（display:none 仍會下載）。
const secondary = dedupe.take([...featuredArticles(all), ...all], 5);

// 最新文章：單一等高大圖網格（補滿空間）
const latest = dedupe.take(all, 12, false);

// 8 月衝刺入口依台北日期自動輪替；日期過後不留過期活動占首頁版位。
// 槽位決策（主打／當令／次入口）全在 resolveSeasonalSlots，這裡只把 topicId 對回實體後渲染。
const topics = await getTopics();
const { primary: primarySlot, companion: companionSlot } = resolveSeasonalSlots(new Date());
const primaryTopic = primarySlot
  ? topics.find((topic) => topic.id === primarySlot.topicId)
  : undefined;
const companionTopic = companionSlot
  ? topics.find((topic) => topic.id === companionSlot.topicId)
  : undefined;
const primaryLead = primarySlot?.leadArticleSlug
  ? all.find((article) => articleSlug(article) === primarySlot.leadArticleSlug)
  : undefined;
const primaryTopicCount = primaryTopic ? articlesForTopic(all, primaryTopic).length : 0;
const companionTopicCount = companionTopic
  ? articlesForTopic(all, companionTopic).length
  : 0;

// 分類主題導覽：首頁過去只連到 7 個分類本身，分類底下的細分主題頁（如「科技／AI」）
// 完全沒有首頁內鏈入口，只能靠分類頁內部或站內搜尋找到，內鏈密度偏低。
// 這裡只列「有文章」的子分類（與 [category]/[sub].astro 建頁條件一致），不會產生死連結。
const topicGroups = CATEGORIES.filter((c) => c.slug !== 'columns')
  .map((c) => {
    const inCat = byCategory(all, c.slug);
    const subs = c.subcategories
      .map((s) => ({ ...s, count: bySubcategory(inCat, s.slug).length }))
      .filter((s) => s.count > 0)
      .sort((a, b) => b.count - a.count)
      .slice(0, 4);
    return { category: c, subs };
  })
  .filter((g) => g.subs.length > 0);

const heroCover = hero ? coverImageFor(hero) : '';
const heroHref = hero ? url(articlePath(hero)) : '#';

// 首頁精選＋最新文章的 ItemList，讓答案引擎能列舉本站當前的重點內容（依畫面順序）。
const homeListItems = articleListItems([...(hero ? [hero] : []), ...secondary, ...latest]);
const homeLd = itemListLd(Astro.site, homeListItems, { name: 'APPI News 精選與最新文章' });
---

<BaseLayout title="首頁" path="/" ogImage="og/home.png" jsonld={homeLd}>
  <!-- 網站介紹 Hero 區：承接從 header 移下來的中文定位 + 站台介紹 -->
  <section class="intro">
    <HeroNetwork />
    <div class="container intro-inner">
      <div class="intro-text">
        <span class="intro-eyebrow">{SITE.taglineEn}</span>
        <h1 class="intro-title">{SITE.tagline}</h1>
        <p class="intro-desc">
          聚集各領域專業作者，以新聞、評論、專欄、專題、專訪與深度分析，協助讀者理解健康、科技、財經、國際、運動與生活中的重要議題。
        </p>
        <div class="intro-cta">
          <a class="btn btn--primary" href={url('/articles/')}>探索所有文章</a>
          <a class="btn btn--ghost" href="#editors-pick">查看編輯精選</a>
        </div>
      </div>
    </div>
  </section>

  {
    primarySlot && primaryTopic && (
      <section
        class:list={['home-seasonal', { 'home-seasonal--with-image': primarySlot.promoted }]}
        aria-labelledby="seasonal-topic-title"
      >
        <div class="container">
          <a
            class="seasonal-topic-primary"
            href={url(`/topics/${primaryTopic.id}/`)}
            data-seasonal-topic-id={primaryTopic.id}
            data-seasonal-slot="primary"
          >
            {
              primarySlot.promoted && primaryLead && (
                <span class="seasonal-topic-media">
                  <ImageWithFallback
                    src={coverImageFor(primaryLead)}
                    alt={coverAltFor(primaryLead)}
                    fallback="og/health.png"
                    class="seasonal-topic-image"
                    loading="eager"
                    fetchpriority="high"
                    width={1280}
                    height={720}
                  />
                </span>
              )
            }
            <span class="seasonal-topic-primary-copy">
              <span class="seasonal-topic-primary-marker">
                {primarySlot.eyebrow}
              </span>
              <span class="seasonal-topic-primary-title" id="seasonal-topic-title">
                {primarySlot.title ?? primaryTopic.data.title}
              </span>
              <span class="seasonal-topic-primary-desc">{primarySlot.description}</span>
              <span class="seasonal-topic-primary-meta">
                {primaryTopicCount} 篇指南　查看專題 →
              </span>
            </span>
          </a>
          {
            companionSlot && companionTopic && (
              <a
                class="seasonal-topic-secondary"
                href={url(`/topics/${companionTopic.id}/`)}
                data-seasonal-topic-id={companionTopic.id}
                data-seasonal-slot="companion"
              >
                <span class="seasonal-topic-secondary-copy">
                  <span class="seasonal-topic-secondary-eyebrow">
                    {companionSlot.eyebrow}
                  </span>
                  <span class="seasonal-topic-secondary-title">{companionSlot.title ?? companionTopic.data.title}</span>
                </span>
                <span class="seasonal-topic-secondary-meta">
                  {companionTopicCount} 篇指南　查看專題 →
                </span>
              </a>
            )
          }
        </div>
      </section>
    )
  }

  <script>
    document
      .querySelectorAll<HTMLAnchorElement>('a[data-seasonal-topic-id][data-seasonal-slot]')
      .forEach((link) => {
        link.addEventListener('click', () => {
          const topicId = link.dataset.seasonalTopicId;
          const slot = link.dataset.seasonalSlot;
          const gtag = (window as unknown as { gtag?: (...args: unknown[]) => void }).gtag;
          if (!topicId || !slot || typeof gtag !== 'function') return;

          gtag('event', 'seasonal_topic_click', {
            topic_id: topicId,
            slot,
            link_url: link.href,
            content_group: `首頁季節入口｜${slot}｜${topicId}`,
          });
        });
      });
  </script>

  {
    hero && (
      <div class="container">
        <section class="section feature-section" id="editors-pick">
          <div class="section-head">
            <h2>編輯精選</h2>
            <a class="more-link" href={url('/articles/')}>所有文章 →</a>
          </div>

          <div class="feature">
            <article class="feature-main">
              <a class="feature-media" href={heroHref} tabindex="-1" aria-hidden="true">
                <ImageWithFallback
                  src={heroCover}
                  alt={coverAltFor(hero)}
                  fallback={`og/${hero.data.category}.png`}
                  loading="eager"
                  fetchpriority="high"
                  class="feature-img"
                />
              </a>
              <div class="feature-text">
                <CategoryTag category={hero.data.category} subcategory={hero.data.subcategory} />
                <h3 class="feature-title"><a href={heroHref}>{hero.data.title}</a></h3>
                <p class="feature-excerpt">{hero.data.excerpt ?? hero.data.description}</p>
                <span class="feature-meta">
                  {authorName(hero.data.author)} · {formatDate(hero.data.publishDate)}
                </span>
              </div>
            </article>

            <div class="feature-side">
              {
                secondary.map((a) => (
                  <a class="side-item" href={url(`/articles/${articleSlug(a)}/`)}>
                    <span class="side-thumb">
                      <ImageWithFallback
                        src={coverImageFor(a)}
                        alt={coverAltFor(a)}
                        fallback={`og/${a.data.category}.png`}
                        class="side-img"
                      />
                    </span>
                    <span class="side-body">
                      <span class="side-title">{a.data.title}</span>
                      <span class="side-meta">
                        {authorName(a.data.author)} · {formatDate(a.data.publishDate)}
                      </span>
                    </span>
                  </a>
                ))
              }
            </div>
          </div>
        </section>
      </div>
    )
  }

  <div class="container">
    <section class="section home-latest">
      <div class="section-head">
        <h2>最新文章</h2>
        <a class="more-link" href={url('/articles/')}>所有文章 →</a>
      </div>
      <div class="card-grid">
        {
          latest.map((a) => (
            <ArticleCard
              article={a}
              variant="medium"
              showExcerpt={false}
              authorName={authorNames.get(a.data.author)}
            />
          ))
        }
      </div>
    </section>

    <section class="section home-topics">
      <div class="section-head">
        <h2>分類主題導覽</h2>
      </div>
      <div class="topic-groups">
        {
          topicGroups.map(({ category, subs }) => (
            <div class="topic-group">
              <a class="topic-group-title" href={url(`/${category.slug}/`)}>
                {category.name}
              </a>
              <div class="topic-chips">
                {subs.map((s) => (
                  <a class="topic-chip" href={url(`/${category.slug}/${s.slug}/`)}>
                    {s.name}
                  </a>
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* ---------- 網站介紹 Hero 區 ---------- */
  .intro {
    position: relative;
    background:
      radial-gradient(120% 150% at 88% 0%, var(--bg-tint) 0%, transparent 58%),
      linear-gradient(180deg, var(--bg-soft) 0%, var(--white) 100%);
    border-bottom: 1px solid var(--line-2);
  }
  .intro-inner {
    position: relative;
    z-index: 1;
    padding-top: 64px;
    padding-bottom: 32px; /* 收窄報頭與「編輯精選」之間的間距（搭配 .feature-section margin-top） */
  }
  /* 拿掉右側 Editorial Index 後改為置中報頭：左右網絡背景對稱，避免單側留白 */
  .intro-text {
    max-width: 680px;
    margin: 0 auto;
    text-align: center;
  }
  .intro-eyebrow {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--appi-accent);
    font-weight: 600;
  }
  .intro-title {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    line-height: 1.2;
    margin: 12px 0 0;
    color: var(--ink);
  }
  .intro-desc {
    margin: 16px auto 28px;
    font-size: var(--text-base);
    line-height: 1.8;
    color: var(--ink-2);
    max-width: 52ch;
  }
  .intro-cta {
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
  }

  /* ---------- 編輯精選 ---------- */
  /* 收窄與上方報頭的間距（全站 .section 上下 margin 為 56px，此處只縮上緣） */
  .feature-section {
    margin-top: 28px;
  }
  .feature {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 40px;
    /* 兩欄等高（grid 預設 stretch）。左欄（圖+文）較高，右欄用 space-between 撐開填滿 */
  }
  /* 大圖固定 16:9（永不變形＝CLS 0）；max-height 只在 ultrawide（左欄極寬時）防止 16:9
     算出過高，超過後改為較寬的裁切而非繼續長高。勿改成 flex 動態高度（會讓圖變直幅/超扁，
     見此區歷次踩坑）。 */
  .feature-media {
    display: block;
    width: 100%; /* 強制填滿欄寬：ultrawide 觸 max-height 時只裁高（寬幅 banner），不縮寬留橫向白 */
    overflow: hidden;
    border-radius: var(--radius);
    aspect-ratio: 16 / 9;
    max-height: 620px;
    background: var(--bg-soft);
    box-shadow: var(--shadow-md);
  }
  /* postbuild 會把 feature 圖包進 <picture>（大螢幕換高解圖）；picture 預設 inline，
     需 block 撐滿 .feature-media 外框，圖才不會塌高（CLS 仍由外框 aspect-ratio 控制）。 */
  .feature-media :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }
  :global(.feature-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .feature-media:hover :global(.feature-img) {
    transform: scale(1.03);
  }
  .feature-text {
    padding-top: 18px;
  }
  .feature-title {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    line-height: 1.3;
    margin: 12px 0;
  }
  .feature-title a {
    color: var(--ink);
    text-decoration: none;
  }
  .feature-title a:hover {
    color: var(--appi-brand);
  }
  .feature-excerpt {
    color: var(--ink-2);
    font-size: var(--text-base);
    line-height: 1.7;
    margin: 0 0 14px;
  }
  .feature-meta {
    font-size: var(--text-xs);
    color: var(--ink-3);
    font-family: var(--font-sans);
  }

  /* 精選右側：含小縮圖的文章清單（金色強調左線）。
     space-between：項目均勻撐開填滿左欄高度 → 無留白，不靠扭曲大圖。 */
  .feature-side {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border-left: 3px solid var(--appi-accent);
    padding-left: 24px;
  }
  .side-item {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 16px 0;
    text-decoration: none;
    border-bottom: 1px solid var(--line-2);
  }
  .side-item:first-child {
    padding-top: 0;
  }
  /* 末則去底線與底內距 */
  .side-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }
  .side-thumb {
    flex: 0 0 120px;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--bg-soft);
  }
  :global(.side-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .side-item:hover :global(.side-img) {
    transform: scale(1.05);
  }
  .side-body {
    flex: 1;
    min-width: 0;
  }
  .side-title {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.25rem; /* 20px — 恢復至先前列表字級 */
    line-height: 1.45;
    color: var(--ink);
    /* trim 首行行高 leading，讓縮圖上緣對齊標題「筆畫」上緣（而非行框上緣），
       固定圖文頂對齊格式，不因標題 2/3 行而產生視覺落差。 */
    margin-top: -0.2em;
  }
  .side-item:hover .side-title {
    color: var(--appi-brand);
  }
  .side-meta {
    display: block;
    margin-top: 6px;
    font-size: var(--text-xs);
    color: var(--ink-3);
    font-family: var(--font-sans);
  }

  /* ---------- 首頁季節主題入口：主題先於編輯精選，保持可見且可掃讀 ---------- */
  .home-seasonal {
    margin: 28px 0 44px;
  }
  .seasonal-topic-primary {
    display: flex;
    align-items: stretch;
    border: 1px solid var(--line);
    border-left: 5px solid var(--appi-brand);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-soft);
    color: var(--ink);
    text-decoration: none;
  }
  .home-seasonal--with-image .seasonal-topic-primary {
    display: grid;
    grid-template-columns: minmax(280px, 0.9fr) minmax(0, 1.1fr);
  }
  .seasonal-topic-media {
    min-height: 236px;
    overflow: hidden;
    background: var(--line-2);
  }
  :global(.seasonal-topic-image) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }
  .seasonal-topic-primary-copy {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    padding: 28px 32px;
  }
  .seasonal-topic-primary-marker {
    color: var(--appi-accent-ink);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .seasonal-topic-primary-title {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: 1.25;
  }
  .seasonal-topic-primary-desc {
    color: var(--ink-2);
    font-size: var(--text-base);
    line-height: 1.6;
  }
  .seasonal-topic-primary-meta {
    margin-top: auto;
    color: var(--appi-brand);
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: 700;
  }
  .seasonal-topic-primary:hover .seasonal-topic-primary-title,
  .seasonal-topic-primary:hover .seasonal-topic-primary-meta {
    color: var(--appi-accent-ink);
  }
  .seasonal-topic-primary:hover :global(.seasonal-topic-image) {
    transform: scale(1.03);
  }
  .seasonal-topic-secondary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-top: 12px;
    padding: 14px 20px;
    border: 1px solid var(--line-2);
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--ink);
    text-decoration: none;
  }
  .seasonal-topic-secondary-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 3px;
  }
  .seasonal-topic-secondary-eyebrow,
  .seasonal-topic-secondary-meta {
    color: var(--ink-3);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
  }
  .seasonal-topic-secondary-title {
    font-family: var(--font-serif);
    font-weight: 700;
  }
  .seasonal-topic-secondary-meta {
    flex: 0 0 auto;
    font-weight: 600;
  }
  .seasonal-topic-secondary:hover .seasonal-topic-secondary-title,
  .seasonal-topic-secondary:hover .seasonal-topic-secondary-meta {
    color: var(--appi-brand);
  }

  .home-latest :global(.acard--medium .acard-title) {
    font-size: 1.375rem; /* 22px */
  }

  /* ---------- 分類主題導覽：補齊首頁到細分主題頁的內鏈入口 ---------- */
  .topic-groups {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 24px;
  }
  .topic-group-title {
    display: inline-block;
    font-family: var(--font-serif);
    font-size: var(--text-base);
    font-weight: 600;
    color: var(--ink);
    text-decoration: none;
    margin-bottom: 10px;
  }
  .topic-group-title:hover {
    color: var(--appi-brand);
  }
  .topic-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .topic-chip {
    font-size: var(--text-xs);
    font-family: var(--font-sans);
    color: var(--ink-2);
    background: var(--bg-soft);
    padding: 4px 12px;
    border-radius: 20px;
    text-decoration: none;
    transition: background 0.15s, color 0.15s;
  }
  .topic-chip:hover {
    background: var(--appi-brand);
    color: var(--white);
  }

  @media (max-width: 1100px) {
    /* ≤1100：編輯精選改上下堆疊。窄欄時左圖（16:9）偏短、右側 5 則偏高，
       並排會在左下留白；堆疊（大圖在上、清單在下）才不留白。報頭也順勢收窄。 */
    .intro-inner {
      padding-top: 44px;
      padding-bottom: 44px;
    }
    .feature {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    /* 單欄堆疊時右側清單在大圖下方，移除金色左線改頂線 */
    .feature-side {
      border-left: none;
      padding-left: 0;
      border-top: 1px solid var(--line);
      padding-top: 8px;
    }
    /* 堆疊時清單為整列寬，縮圖略收，避免相對顯小 */
    .side-thumb {
      flex-basis: 96px;
    }
  }

