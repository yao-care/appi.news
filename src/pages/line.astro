---
import BaseLayout from '@/layouts/BaseLayout.astro';

const addUrl = 'https://line.me/R/ti/p/@832sacsk';
const qrUrl = 'https://qr-official.line.me/gs/M_832sacsk_GW.png';
const features = [
  ['看今天這一份', '按選單「看新聞」，或直接打「新聞」', '一次一則，每則可以看全文或下一則，不想看的可以跳過。'],
  ['換個分類看', '按選單「分類」，或打「分類」', '焦點、健康、科技、財經、國際、運動、生活；不占用每天那一份。'],
  ['打關鍵字找新聞', '直接輸入想找的字，例如「電價」', '搜尋不占用每天那一份；沒有直接相關內容時，仍會提供今天值得看的新聞。'],
  ['看完今天的', '讀完後自動出現', '查看連續閱讀天數、今天讀了幾則，以及當季進度。'],
  ['調整推薦', '按完成畫面的「最近想看點別的」', '當推薦不對味時，增加不同題材。'],
  ['關於', '按選單「關於」，或打「關於」', '了解 APPI News 與這個閱讀入口。'],
];
---

<BaseLayout
  title="APPI News LINE 官方帳號｜每天一份新聞"
  description="加入 APPI News LINE 官方帳號：不主動推播，想看的時候取得每天一份新聞，也能依分類或關鍵字找文章。"
  path="/line/"
  ogImage="og/default.png"
>
  <section class="line-hero">
    <div class="container line-hero-grid">
      <div class="line-hero-copy">
        <p class="line-eyebrow">APPI News｜亞太專業觀點</p>
        <h1>每天一份新聞，看完就結束</h1>
        <p>
          APPI News 聚集各領域專業作者，涵蓋健康、科技、財經、國際、運動與生活。
          LINE 是你想看的時候才打開的閱讀入口：一次一則，不會沒完沒了。
        </p>
        <p class="line-no-push"><strong>我們不會主動傳訊息給你。</strong>不推播、不轟炸，也不在你忙的時候跳出來。</p>
        <div class="line-actions">
          <a class="line-add" href={addUrl} target="_blank" rel="noopener">加入 APPI News LINE</a>
          <span>LINE ID：<strong>@832sacsk</strong></span>
        </div>
      </div>
      <a class="line-qr" href={addUrl} target="_blank" rel="noopener" aria-label="加入 APPI News LINE 官方帳號">
        <img src={qrUrl} alt="加入 APPI News LINE 官方帳號的 QR Code" width="360" height="360" />
        <span>掃描 QR Code 加入</span>
      </a>
    </div>
  </section>

  <div class="container line-page">
    <aside class="pin-tip">
      <strong>加入後建議花十秒把聊天室置頂。</strong>
      因為不推播，帳號會被其他訊息往下擠。iPhone 在聊天列表向左滑後選「置頂」；Android 長按聊天室後選「置頂」。
    </aside>

    <section class="line-section" aria-labelledby="line-features-title">
      <div class="section-head"><h2 id="line-features-title">可以做什麼</h2></div>
      <div class="feature-list">
        {features.map(([title, action, description]) => (
          <article class="feature-item">
            <h3>{title}</h3>
            <p class="feature-action">{action}</p>
            <p>{description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="line-section line-two-col">
      <article>
        <h2>可以拉進群組</h2>
        <p>
          加入群組後，APPI News 只會在被 @提及，或整則訊息就是「新聞」時回應；其他對話不會插嘴。
          群組一次只給一則新聞與「看全文」，不提供連續翻頁，避免洗掉聊天室內容。
        </p>
      </article>
      <article>
        <h2>你的閱讀紀錄由你決定</h2>
        <p>
          封鎖或刪除好友，或把 APPI News 移出群組後，個人化模型與閱讀紀錄會一併刪除。
        </p>
      </article>
    </section>

    <section class="line-bottom-cta">
      <h2>想看的時候，再來看今天這一份</h2>
      <p>加入後輸入「新聞」，就能開始閱讀。</p>
      <a class="line-add" href={addUrl} target="_blank" rel="noopener">加入 APPI News LINE</a>
    </section>
  </div>
</BaseLayout>

<style>
  .line-hero {
    margin-bottom: 36px;
    padding-block: 56px;
    background: var(--bg-tint);
    border-bottom: 1px solid var(--line);
  }
  .line-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    align-items: center;
    gap: 64px;
    max-width: 1020px;
  }
  .line-eyebrow {
    margin: 0 0 8px;
    color: var(--appi-brand);
    font-size: var(--text-sm);
    font-weight: 700;
  }
  .line-hero h1 {
    max-width: 720px;
    margin-bottom: 18px;
    font-size: var(--text-3xl);
  }
  .line-hero-copy > p:not(.line-eyebrow) {
    max-width: 720px;
    color: var(--ink-2);
    line-height: 1.8;
  }
  .line-no-push {
    padding-left: 14px;
    border-left: 3px solid var(--appi-brand);
  }
  .line-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-top: 26px;
    color: var(--ink-2);
    font-size: var(--text-sm);
  }
  .line-add {
    display: inline-flex;
    justify-content: center;
    padding: 11px 20px;
    border-radius: 999px;
    background: var(--appi-brand);
    color: var(--white);
    font-weight: 700;
    text-decoration: none;
  }
  .line-add:hover {
    background: var(--appi-brand-dark);
    text-decoration: none;
  }
  .line-qr {
    display: block;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    color: var(--ink-2);
    text-align: center;
    font-size: var(--text-xs);
    font-weight: 600;
  }
  .line-qr:hover {
    text-decoration: none;
  }
  .line-qr img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: contain;
    margin-bottom: 8px;
  }
  .line-page {
    max-width: 1020px;
  }
  .pin-tip {
    margin-bottom: 52px;
    padding: 18px 20px;
    border-radius: var(--radius-sm);
    background: var(--bg-soft);
    color: var(--ink-2);
    line-height: 1.7;
  }
  .line-section {
    margin-block: 52px;
  }
  .feature-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 36px;
  }
  .feature-item {
    padding-block: 20px;
    border-bottom: 1px solid var(--line);
  }
  .feature-item h3 {
    margin-bottom: 6px;
    font-size: var(--text-base);
  }
  .feature-item p {
    margin: 5px 0 0;
    color: var(--ink-2);
    font-size: var(--text-sm);
  }
  .feature-item .feature-action {
    color: var(--appi-brand);
    font-weight: 700;
  }
  .line-two-col {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }
  .line-two-col article {
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .line-two-col h2 {
    font-size: var(--text-lg);
  }
  .line-two-col p {
    margin: 0;
    color: var(--ink-2);
    line-height: 1.8;
  }
  .line-bottom-cta {
    margin-block: 64px;
    padding: 44px 24px;
    border-radius: var(--radius);
    background: var(--bg-tint);
    text-align: center;
  }
  .line-bottom-cta p {
    margin: 0 0 20px;
    color: var(--ink-2);
  }
  @media (max-width: 760px) {
    .line-hero {
      padding-block: 40px;
    }
    .line-hero-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .line-hero h1 {
      font-size: var(--text-2xl);
    }
    .line-qr {
      width: min(100%, 300px);
      justify-self: center;
    }
    .feature-list,
    .line-two-col {
      grid-template-columns: 1fr;
    }
  }
</style>
