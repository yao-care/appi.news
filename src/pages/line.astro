---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { url } from '@/utils/url';

const addUrl = 'https://line.me/R/ti/p/@832sacsk';
const qrUrl = 'https://qr-official.line.me/gs/M_832sacsk_GW.png';

const coreFeatures = [
  [
    '今日新聞',
    '掌握今天值得關注的重要消息。一次閱讀一則，可查看完整報導、讀下一則，或略過。',
  ],
  [
    '依主題瀏覽',
    '從焦點、國際、健康、科技、財經、運動與生活中，直接查看你感興趣的內容。',
  ],
  [
    '搜尋新聞',
    '輸入人物、事件或關鍵字，例如「台積電」、「葉黃素」或「電價」，即可尋找相關報導。',
  ],
];

const readerControls = [
  '預設不主動推播，想看的時候再打開',
  '可自行選擇感興趣的新聞主題',
  '可查看最近閱讀',
  '可隨時調整閱讀偏好',
];
---

<BaseLayout
  title="用 LINE 快速掌握今日新聞"
  description="在 LINE 查看 APPI News 的今日新聞、依主題瀏覽，或直接搜尋你關心的議題。預設不主動推播，想看的時候再打開。"
  path="/line/"
  ogImage="og/default.png"
>
  <section class="line-hero">
    <div class="container line-hero-grid">
      <div class="line-hero-copy">
        <p class="line-eyebrow">APPI News LINE</p>
        <h1>今日新聞，快速掌握</h1>
        <p>
          APPI News 將每日值得關注的新聞帶進 LINE。查看今日重點、依主題瀏覽，或直接搜尋你關心的新聞。
        </p>
        <div class="line-actions">
          <a class="line-add" href={addUrl} target="_blank" rel="noopener">加入 APPI News LINE</a>
          <span>LINE ID：<strong>@832sacsk</strong></span>
        </div>
        <p class="line-no-push">預設不主動推播，想看的時候再打開。</p>
      </div>
      <a class="line-qr" href={addUrl} target="_blank" rel="noopener" aria-label="加入 APPI News LINE 官方帳號">
        <img src={qrUrl} alt="加入 APPI News LINE 官方帳號的 QR Code" width="360" height="360" />
        <span>掃描 QR Code 加入</span>
      </a>
    </div>
  </section>

  <div class="container line-page">
    <section class="line-section" aria-labelledby="line-core-title">
      <div class="section-head"><h2 id="line-core-title">用 LINE 看 APPI News</h2></div>
      <div class="core-list">
        {coreFeatures.map(([title, description]) => (
          <article class="core-item">
            <h3>{title}</h3>
            <p>{description}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="line-section line-search">
      <div class="line-search-copy">
        <h2>不只看新聞，也能直接找新聞</h2>
        <p>
          想知道某個人物或議題的最新報導，直接把關鍵字打進 LINE，APPI News 就替你找出相關內容。
        </p>
      </div>
      <div class="chat-demo" aria-hidden="true">
        <div class="chat-row chat-row--user">
          <span class="chat-bubble chat-bubble--user">台積電</span>
        </div>
        <div class="chat-row chat-row--bot">
          <span class="chat-bubble chat-bubble--bot">
            <span class="chat-name">APPI News</span>
            找到以下相關報導：
            <span class="chat-news">・台積電最新財報與後市展望</span>
            <span class="chat-news">・台積電美國廠進度一次看</span>
          </span>
        </div>
      </div>
    </section>

    <section class="line-section">
      <div class="section-head"><h2>在 LINE 群組也能使用</h2></div>
      <p class="line-lead">
        把 APPI News 加入群組，需要新聞時 <strong>@APPI News</strong> 就好，例如「@APPI News 今天有什麼新聞」或「@APPI News 台積電」。
        平常它不會插進你們的對話，回應時一次只給一則、不連續洗版。
      </p>
    </section>

    <section class="line-section">
      <div class="section-head"><h2>新聞由你決定怎麼看</h2></div>
      <ul class="control-list">
        {readerControls.map((item) => <li>{item}</li>)}
      </ul>
      <div class="privacy-note">
        <h3>你的閱讀資料由你掌握</h3>
        <p>
          APPI News 僅使用必要的互動與閱讀資料，來提供你選擇的閱讀體驗。相關資料的使用與處理，依
          <a href={url('/privacy/')}>隱私權政策</a>辦理。
        </p>
      </div>
    </section>

    <section class="line-bottom-cta">
      <h2>把 APPI News 放進 LINE</h2>
      <p>今天想知道發生什麼事，打開 LINE 就能開始。</p>
      <a class="line-add" href={addUrl} target="_blank" rel="noopener">加入 APPI News LINE</a>
    </section>
  </div>
</BaseLayout>

<style>
  .line-hero {
    margin-bottom: 36px;
    padding-block: 56px;
    background: var(--bg-tint);
    border-bottom: 1px solid var(--line);
  }
  .line-hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    align-items: center;
    gap: 64px;
    max-width: 1020px;
  }
  .line-eyebrow {
    margin: 0 0 8px;
    color: var(--appi-brand);
    font-size: var(--text-sm);
    font-weight: 700;
  }
  .line-hero h1 {
    max-width: 720px;
    margin-bottom: 18px;
    font-size: var(--text-3xl);
  }
  .line-hero-copy > p:not(.line-eyebrow):not(.line-no-push) {
    max-width: 720px;
    color: var(--ink-2);
    line-height: 1.8;
  }
  .line-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-top: 26px;
    color: var(--ink-2);
    font-size: var(--text-sm);
  }
  .line-no-push {
    margin-top: 14px;
    color: var(--ink-3);
    font-size: var(--text-sm);
  }
  .line-add {
    display: inline-flex;
    justify-content: center;
    padding: 11px 20px;
    border-radius: 999px;
    background: var(--appi-brand);
    color: var(--white);
    font-weight: 700;
    text-decoration: none;
  }
  .line-add:hover {
    background: var(--appi-brand-dark);
    text-decoration: none;
  }
  .line-qr {
    display: block;
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
    color: var(--ink-2);
    text-align: center;
    font-size: var(--text-xs);
    font-weight: 600;
  }
  .line-qr:hover {
    text-decoration: none;
  }
  .line-qr img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: contain;
    margin-bottom: 8px;
  }
  .line-page {
    max-width: 1020px;
  }
  .line-section {
    margin-block: 52px;
  }
  .line-lead,
  .line-search-copy p {
    max-width: 760px;
    margin: 0;
    color: var(--ink-2);
    line-height: 1.8;
  }
  .core-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 8px;
  }
  .core-item {
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
  }
  .core-item h3 {
    margin-bottom: 8px;
    font-size: var(--text-lg);
    color: var(--appi-brand);
  }
  .core-item p {
    margin: 0;
    color: var(--ink-2);
    font-size: var(--text-sm);
    line-height: 1.75;
  }
  .line-search {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: 40px;
  }
  .line-search-copy h2 {
    margin-bottom: 12px;
  }
  .chat-demo {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-soft);
  }
  .chat-row {
    display: flex;
  }
  .chat-row--user {
    justify-content: flex-end;
  }
  .chat-row--bot {
    justify-content: flex-start;
  }
  .chat-bubble {
    max-width: 82%;
    padding: 12px 16px;
    border-radius: var(--radius);
    font-size: var(--text-sm);
    line-height: 1.7;
  }
  .chat-bubble--user {
    background: var(--appi-brand);
    color: var(--white);
    border-bottom-right-radius: var(--radius-sm);
  }
  .chat-bubble--bot {
    display: flex;
    flex-direction: column;
    background: var(--white);
    color: var(--ink);
    border: 1px solid var(--line);
    border-bottom-left-radius: var(--radius-sm);
  }
  .chat-name {
    margin-bottom: 4px;
    color: var(--appi-brand);
    font-size: var(--text-xs);
    font-weight: 700;
  }
  .chat-news {
    margin-top: 6px;
    color: var(--ink-2);
  }
  .control-list {
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px 24px;
    max-width: 760px;
  }
  .control-list li {
    position: relative;
    padding-left: 22px;
    color: var(--ink-2);
    line-height: 1.7;
  }
  .control-list li::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 0.75em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--appi-brand);
  }
  .privacy-note {
    margin-top: 28px;
    padding: 20px 22px;
    border-radius: var(--radius-sm);
    background: var(--bg-soft);
  }
  .privacy-note h3 {
    margin-bottom: 6px;
    font-size: var(--text-base);
  }
  .privacy-note p {
    margin: 0;
    color: var(--ink-2);
    font-size: var(--text-sm);
    line-height: 1.75;
  }
  .line-bottom-cta {
    margin-block: 64px;
    padding: 44px 24px;
    border-radius: var(--radius);
    background: var(--bg-tint);
    text-align: center;
  }
  .line-bottom-cta p {
    margin: 0 0 20px;
    color: var(--ink-2);
  }
  @media (max-width: 760px) {
    .line-hero {
      padding-block: 40px;
    }
    .line-hero-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .line-hero h1 {
      font-size: var(--text-2xl);
    }
    .line-qr {
      width: min(100%, 300px);
      justify-self: center;
    }
    .core-list,
    .line-search,
    .control-list {
      grid-template-columns: 1fr;
    }
  }
</style>
