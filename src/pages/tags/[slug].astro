---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/blocks/ArticleCard.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import {
  getPublishedArticles,
  getAuthorNames,
  byTag,
  tagStats,
  slugify,
  isIndexableTag,
  articleListItems,
} from '@/utils/content';
import { breadcrumbLd, itemListLd } from '@/utils/jsonld';

export async function getStaticPaths() {
  const all = await getPublishedArticles();
  const tags = tagStats(all);
  return tags.map((t) => ({
    params: { slug: slugify(t.tag) },
    props: { tag: t.tag, count: t.count },
  }));
}

const { tag, count } = Astro.props;
const all = await getPublishedArticles();
const authorNames = await getAuthorNames();
const articles = byTag(all, tag);
const path = `/tags/${slugify(tag)}/`;

// 未達門檻的單篇標籤頁：noindex（薄頁不進索引），且由 astro.config.mjs 排除於 sitemap。
const indexable = isIndexableTag(count);

const ld = [
  breadcrumbLd(Astro.site, [
    { name: '首頁', path: '/' },
    { name: '標籤', path: '/tags/' },
    { name: `#${tag}`, path },
  ]),
  ...(indexable
    ? [
        itemListLd(Astro.site, articleListItems(articles), { name: `標籤：${tag}` }),
      ]
    : []),
];
---
<BaseLayout
  title={`#${tag}`}
  description={`所有標記「${tag}」的 APPI News 文章，共 ${count} 篇。`}
  path={path}
  noindex={!indexable}
  jsonld={ld}
>
  <div class="container" style="padding-top:28px;">
    <Breadcrumbs items={[{ name: '標籤', path: '/tags/' }, { name: `#${tag}` }]} />
    <header class="section-head" style="margin-top:18px;">
      <h1>#{tag}</h1>
      <span class="more-link">{count} 篇文章</span>
    </header>
    <div class="card-grid card-grid--4">
      {articles.map((a) => <ArticleCard article={a} variant="medium" authorName={authorNames.get(a.data.author)} />)}
    </div>
  </div>
</BaseLayout>
