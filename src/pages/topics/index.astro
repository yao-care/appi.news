---
import BaseLayout from '@/layouts/BaseLayout.astro';
import TopicCard from '@/components/blocks/TopicCard.astro';
import Breadcrumbs from '@/components/ui/Breadcrumbs.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import { getTopics, getPublishedArticles, byTopic, articleSlug } from '@/utils/content';
import { breadcrumbLd, itemListLd } from '@/utils/jsonld';

const topics = await getTopics();
const all = await getPublishedArticles();
// 手動指定的 articles 與 article.topics 反向關聯常重疊，需去重後才是實際顯示篇數
const cards = topics.map((t) => {
  const manual = all.filter(
    (a) => t.data.articles.includes(articleSlug(a)) || t.data.articles.includes(a.id),
  );
  const seen = new Set<string>();
  const count = [...manual, ...byTopic(all, t.id)].filter((a) => {
    const key = articleSlug(a);
    if (seen.has(key)) return false;
    seen.add(key);
    return true;
  }).length;
  return { topic: t, count };
});

const ld = [
  breadcrumbLd(Astro.site, [
    { name: '首頁', path: '/' },
    { name: '專題', path: '/topics/' },
  ]),
  ...(cards.length > 0
    ? [
        itemListLd(
          Astro.site,
          cards.map((c) => ({ name: c.topic.data.title, path: `/topics/${c.topic.id}/` })),
          { name: '專題' },
        ),
      ]
    : []),
];
---
<BaseLayout
  title="專題"
  description="APPI News 專題：整理系列文章，深入特定議題。"
  path="/topics/"
  jsonld={ld}
>
  <div class="container" style="padding-top:28px;">
    <Breadcrumbs items={[{ name: '專題' }]} />
    <header class="section-head" style="margin-top:18px;"><h2>專題</h2></header>
    {
      cards.length > 0 ? (
        <div class="card-grid card-grid--3">
          {cards.map((c) => <TopicCard topic={c.topic} articleCount={c.count} />)}
        </div>
      ) : (
        <EmptyState title="專題即將上線" />
      )
    }
  </div>
</BaseLayout>
